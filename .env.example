# Vacancy source and safe daily database refresh (00:00 Moscow time)
GOOGLE_SHEETS_URL=https://docs.google.com/spreadsheets/d/1Vh__7_9u6-qc6CDHUD3UpScEOCULccFHavomk2stfwg/edit?gid=0#gid=0
GOOGLE_SHEET_NAME=Вакансии_КБ
